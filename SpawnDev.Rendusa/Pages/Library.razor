    private async Task ConfirmAddTorrent()
    {
        if (HasNoTorrentInput) return;
        IsAddingTorrent = true;
        ShowTorrentPrompt = false;
        StatusMessage = "Adding torrent…";
        StateHasChanged();

        try
        {
            WebTorrentFsHandler? handler;
            string name;

            if (TorrentFile != null)
            {
                // .torrent file path
                name = string.IsNullOrWhiteSpace(TorrentDisplayName)
                    ? TorrentFile.Name : TorrentDisplayName.Trim();
                using var stream = TorrentFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                handler = await WtManager.AddTorrentAsync(ms.ToArray(), name, CurrentPath);
            }
            else
            {
                // Magnet / info hash / URL
                name = string.IsNullOrWhiteSpace(TorrentDisplayName)
                    ? TorrentSource.Length > 40 ? TorrentSource[..40] + "…" : TorrentSource
                    : TorrentDisplayName.Trim();
                handler = await WtManager.AddTorrentAsync(TorrentSource.Trim(), name, CurrentPath);
            }

            StatusMessage = handler != null
                ? $"Torrent \"{name}\" added!"
                : "Failed to add torrent.";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"AddTorrent error: {ex.Message}");
            StatusMessage = "Error adding torrent.";
        }
        TorrentFile = null;
        IsAddingTorrent = false;
        StateHasChanged();
        await Task.Delay(3000);
        StatusMessage = null;
    }

    private void PlayFile(IVfsFile file)
    {
        try
        {
            // Use /vfs/ URL — served by service worker proxy
            var vfsUrl = "/vfs" + file.Path;
            var mediaItem = new MediaItem
            {
                Title = file.Name,
                SourceUri = vfsUrl,
                MimeType = file.MimeType,
                Type = MediaLibraryService.DetectMediaType(file.MimeType)
            };

            // Collect all playable media files in current directory as a playlist
            var playableFiles = CurrentNodes.OfType<IVfsFile>().Where(f => IsMediaFile(f)).ToList();
            var items = playableFiles.Select(f => new MediaItem
            {
                Title = f.Name,
                SourceUri = "/vfs" + f.Path,
                MimeType = f.MimeType,
                Type = MediaLibraryService.DetectMediaType(f.MimeType)
            }).ToList();

            NowPlaying.SetItems(items, items.FirstOrDefault(i => i.Title == file.Name)?.Id);
            Navigation.NavigateTo("/player?fromFolder=true");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"PlayFile error: {ex.Message}");
            StatusMessage = "Error playing file.";
        }
    }

