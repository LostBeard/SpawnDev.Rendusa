@page "/library"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject MediaLibraryService MediaLibrary
@inject FileImportService FileImport
@inject NavigationManager Navigation
@inject NowPlayingService NowPlaying
@inject VfsServiceWorkerBridge VfsBridge
@inject WebTorrentManagerService WtManager
@inject SettingsService Settings
@inject BlazorJSRuntime JS
@implements IDisposable
@using SpawnDev.Rendusa.VirtualFS
@using SpawnDev.Rendusa.VirtualFS.Handlers

<PageTitle>Rendusa — Library</PageTitle>

<div class="library-page p-2 animate-fade"
     @oncontextmenu="OnBackgroundContext" @oncontextmenu:preventDefault="true">
    <div class="page-header">
        <h2>Media Library</h2>
        <div class="actions" style="display:flex; gap:0.5rem;">
            @if (MediaLibrary.VFS.IsWritable(CurrentPath))
            {
                <button class="btn" @onclick="ShowNewFolderPrompt">
                    📁 New Folder
                </button>
                <button class="btn" @onclick="ShowNewPlaylistPrompt">
                    🎵 New Playlist
                </button>
            }
            <button class="btn btn-primary" @onclick="AddFiles">
                ➕ Import
            </button>
            @if (IsLocalHandler())
            {
                <button class="btn" @onclick="AddFolder">
                    📂 Link Folder
                </button>
            }
            @if (Settings.Settings.WebTorrentEnabled && MediaLibrary.VFS.IsWritable(CurrentPath))
            {
                <button class="btn" @onclick="ShowAddTorrentModal">
                    🧲 Add Torrent
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="status-bar" style="padding:0.4rem 0.8rem; background:var(--accent-glow); color:var(--accent); border-radius:var(--radius-sm); margin:0.5rem 0; font-size:0.85rem;">
            @StatusMessage
        </div>
    }

    @* === Breadcrumb navigation === *@
    <nav class="breadcrumb" style="margin:0.75rem 0; display:flex; align-items:center; gap:0.3rem; font-size:0.85rem;">
        @foreach (var (label, path) in GetBreadcrumbs())
        {
            if (path == CurrentPath)
            {
                <span style="color:var(--text-primary); font-weight:600;">@label</span>
            }
            else
            {
                <button class="btn-link" @onclick="@(() => NavigateTo(path))" style="background:none; border:none; color:var(--accent); cursor:pointer; padding:0; font-size:0.85rem;">@label</button>
                <span style="color:var(--text-muted); margin:0 0.1rem;">›</span>
            }
        }
    </nav>



    @* === VFS content === *@
    @if (IsLoading)
    {
        <div class="empty-state">
            <div class="empty-icon">⏳</div>
            <p>Loading...</p>
        </div>
    }
    else if (CurrentNodes.Count == 0)
    {
        <div class="empty-state"
             @ondragenter="@(() => IsDragOver = true)" @ondragleave="@(() => IsDragOver = false)"
             @ondragover:preventDefault="true" @ondrop="HandleDrop" @ondrop:preventDefault="true"
             style="@(IsDragOver ? "border-color:var(--accent);background:var(--accent-glow);" : "")">
            <div class="empty-icon">📂</div>
            <p>Nothing here yet.</p>
            <p class="text-muted" style="font-size:0.8rem;">Drag & drop files, or use the toolbar to get started.</p>
        </div>
    }
    else
    {
        <div class="media-grid">
            @foreach (var node in CurrentNodes)
            {
                @if (node.NodeType == VfsNodeType.Directory)
                {
                    <div class="media-card folder-card"
                         @onclick="@(() => NavigateTo(node.Path))"
                         @oncontextmenu="@(e => OpenContextMenu(e, node))" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true"
                         @ontouchstart="@(e => OnTouchStart(e, node))" @ontouchend="OnTouchEnd" @ontouchmove="OnTouchEnd">
                        <div class="thumbnail">
                            <span>📂</span>
                        </div>
                        <div class="card-info">
                            <div class="card-title">@node.Name</div>
                            <div class="card-meta">
                                <span class="badge badge-folder">@GetHandlerLabel(node)</span>
                                @if (node.Metadata?.Source == VfsSource.Remote)
                                {
                                    <span class="badge badge-remote">Remote</span>
                                }
                                @if (node.Handler is FileSystemAccessFsHandler fsa && fsa.ReadOnly)
                                {
                                    <span class="badge badge-readonly">Read-Only</span>
                                }
                            </div>
                            @if (node.Handler is WebTorrentFsHandler wtFolder)
                            {
                                @((MarkupString)GetTorrentFolderStatusHtml(wtFolder, node))
                            }
                            else if (node.Metadata?.Progress is double fp && fp < 1.0)
                            {
                                <div class="progress-bar-container">
                                    <div class="progress-bar-fill" style="width:@($"{fp * 100:F1}%")"></div>
                                </div>
                                <div class="progress-label">@($"{fp * 100:F0}%")</div>
                            }
                        </div>
                    </div>
                }
                else if (node is IVfsFile file)
                {
                    <div class="media-card"
                         @onclick="@(() => OnFileClick(file))"
                         @oncontextmenu="@(e => OpenContextMenu(e, file))" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true"
                         @ontouchstart="@(e => OnTouchStart(e, file))" @ontouchend="OnTouchEnd" @ontouchmove="OnTouchEnd">
                        <div class="thumbnail">
                            @if (file.MimeType?.StartsWith("image/") == true)
                            {
                                <img src="/vfs@(file.Path)" alt="@file.Name" loading="lazy"
                                     onerror="this.dataset.retry=(this.dataset.retry|0)*1+1;if(this.dataset.retry<=3){var img=this;setTimeout(function(){img.src='/vfs@(file.Path)?t='+Date.now()},this.dataset.retry*2000)}else{this.style.display='none';this.nextElementSibling&&(this.nextElementSibling.style.display='')}" />
                                <span style="display:none;">@GetFileEmoji(file)</span>
                            }
                            else
                            {
                                <span>@GetFileEmoji(file)</span>
                            }
                        </div>
                        <div class="card-info">
                            <div class="card-title">@file.Name</div>
                            <div class="card-meta">
                                <span class="badge @GetBadgeClass(file)">@GetMediaTypeLabel(file)</span>
                                <span>@FormatSize(file.Size)</span>
                            </div>
                            @if (file.Handler is WebTorrentFsHandler wtFile)
                            {
                                @((MarkupString)GetTorrentFileStatusHtml(wtFile, file))
                            }
                            else if (file.Metadata?.Progress is double prg && prg < 1.0)
                            {
                                <div class="progress-bar-container">
                                    <div class="progress-bar-fill" style="width:@($"{prg * 100:F1}%")"></div>
                                </div>
                                <div class="progress-label">@($"{prg * 100:F0}%")</div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }

    @* === Right-click context menu === *@
    @if (_contextMenuVisible)
    {
        <div class="context-menu-backdrop" @onclick="CloseContextMenu"></div>
        <div class="context-menu" style="top:@(_contextMenuY)px; left:@(_contextMenuX)px;">
            @if (_contextMenuNode == null)
            {
                @* Background context menu *@
                @if (MediaLibrary.VFS.IsWritable(CurrentPath))
                {
                    <button class="ctx-item" @onclick="@(() => { CloseContextMenu(); ShowNewFolderPrompt(); })">📁 New Folder</button>
                    <button class="ctx-item" @onclick="@(() => { CloseContextMenu(); ShowNewPlaylistPrompt(); })">🎵 New Playlist</button>
                    <div class="ctx-divider"></div>
                }
                <button class="ctx-item" @onclick="@(async () => { CloseContextMenu(); await AddFiles(); })">➕ Import Files</button>
                @if (IsLocalHandler())
                {
                    <button class="ctx-item" @onclick="@(async () => { CloseContextMenu(); await AddFolder(); })">📂 Link Folder</button>
                }
                @if (Settings.Settings.WebTorrentEnabled && MediaLibrary.VFS.IsWritable(CurrentPath))
                {
                    <button class="ctx-item" @onclick="@(() => { CloseContextMenu(); ShowAddTorrentModal(); })">🧲 Add Torrent</button>
                }
            }
            else if (_contextMenuNode.NodeType == VfsNodeType.Directory)
            {
                @* Folder context menu *@
                <button class="ctx-item" @onclick="@(async () => { var n = _contextMenuNode; CloseContextMenu(); await NavigateTo(n.Path); })">📂 Open</button>
                <button class="ctx-item" @onclick="@(async () => { var n = _contextMenuNode; CloseContextMenu(); await PlayAllInDirectory(n); })">▶ Play All</button>
                @if (IsRenamable(_contextMenuNode))
                {
                    <button class="ctx-item" @onclick="@(() => { var n = _contextMenuNode; CloseContextMenu(); ShowRenamePrompt(n); })">✏ Rename</button>
                }
                @if (IsUnlinkable(_contextMenuNode))
                {
                    <button class="ctx-item" @onclick="@(async () => { var n = _contextMenuNode; CloseContextMenu(); await UnlinkFolder(n); })">🔗 Unlink</button>
                }
                @if (_contextMenuNode.Handler is WebTorrentFsHandler wtFolderHandler)
                {
                    <div class="ctx-divider"></div>
                    @if (wtFolderHandler.HasSelectedFilesInDirectory(GetTorrentRelativePath(_contextMenuNode.Path, wtFolderHandler)))
                    {
                        <button class="ctx-item" @onclick="@(() => { var h = wtFolderHandler; var rp = GetTorrentRelativePath(_contextMenuNode!.Path, h); CloseContextMenu(); h.DeselectDirectory(rp); StateHasChanged(); })">⏸ Pause All</button>
                    }
                    <button class="ctx-item" @onclick="@(() => { var h = wtFolderHandler; var rp = GetTorrentRelativePath(_contextMenuNode!.Path, h); CloseContextMenu(); h.SelectDirectory(rp); StateHasChanged(); })">⬇️ Download All</button>
                    <div class="ctx-divider"></div>
                    <button class="ctx-item ctx-danger" @onclick="@(async () => { var n = _contextMenuNode; CloseContextMenu(); await DeleteNode(n); })">🧲 Remove Torrent</button>
                }
                else if (IsDeletable(_contextMenuNode))
                {
                    <div class="ctx-divider"></div>
                    <button class="ctx-item ctx-danger" @onclick="@(async () => { var n = _contextMenuNode; CloseContextMenu(); await DeleteNode(n); })">🗑 Delete</button>
                }
            }
            else if (_contextMenuNode is IVfsFile ctxFile)
            {
                @* File context menu *@
                @if (IsMediaFile(ctxFile))
                {
                    <button class="ctx-item" @onclick="@(() => { var f = (IVfsFile)_contextMenuNode!; CloseContextMenu(); PlayFile(f); })">▶ Play</button>
                }
                @if (IsRenamable(_contextMenuNode))
                {
                    <button class="ctx-item" @onclick="@(() => { var n = _contextMenuNode; CloseContextMenu(); ShowRenamePrompt(n); })">✏ Rename</button>
                }
                @if (IsMediaFile(ctxFile))
                {
                    <button class="ctx-item" @onclick="@(() => { var f = (IVfsFile)_contextMenuNode!; CloseContextMenu(); ShowAddToPlaylistPicker(f); })">🎵 Add to Playlist</button>
                }
                @if (_contextMenuNode.Handler is WebTorrentFsHandler wtFileHandler)
                {
                    <div class="ctx-divider"></div>
                    @if (wtFileHandler.IsFileSelected(GetTorrentRelativePath(_contextMenuNode.Path, wtFileHandler)))
                    {
                        <button class="ctx-item" @onclick="@(() => { var h = wtFileHandler; var rp = GetTorrentRelativePath(_contextMenuNode!.Path, h); CloseContextMenu(); h.DeselectFile(rp); StateHasChanged(); })">⏸ Pause Download</button>
                    }
                    else
                    {
                        <button class="ctx-item" @onclick="@(() => { var h = wtFileHandler; var rp = GetTorrentRelativePath(_contextMenuNode!.Path, h); CloseContextMenu(); h.SelectFile(rp); StateHasChanged(); })">⬇️ Download</button>
                    }
                }
                else if (IsDeletable(_contextMenuNode))
                {
                    <div class="ctx-divider"></div>
                    <button class="ctx-item ctx-danger" @onclick="@(async () => { var n = _contextMenuNode; CloseContextMenu(); await DeleteNode(n); })">🗑 Delete</button>
                }
            }
        </div>
    }

    @* === Import mode prompt modal === *@
    @if (ShowImportModePrompt)
    {
        <div class="modal-overlay" @onclick="CancelImportModePrompt">
            <div class="dialog-panel" @onclick:stopPropagation="true" @onclick="@(() => { })">
                <h3>📁 Import Files</h3>
                <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:1rem;">
                    How would you like to add these files?
                </p>
                <div style="display:flex; flex-direction:column; gap:0.75rem;">
                    <button class="btn" style="text-align:left; padding:0.75rem 1rem; width:100%; box-sizing:border-box; white-space:normal;" @onclick="@(() => ConfirmImportMode(ImportMode.Copy))">
                        <div style="font-weight:600;">📋 Copy into library</div>
                        <div style="font-size:0.8rem; color:var(--text-muted); margin-top:0.25rem;">Files are stored in the app. Works offline.</div>
                    </button>
                    <button class="btn" style="text-align:left; padding:0.75rem 1rem; width:100%; box-sizing:border-box; white-space:normal;" @onclick="@(() => ConfirmImportMode(ImportMode.Link))">
                        <div style="font-weight:600;">🔗 Link in library</div>
                        <div style="font-size:0.8rem; color:var(--text-muted); margin-top:0.25rem;">References the original files. No extra storage used.</div>
                    </button>
                </div>
                <div style="display:flex; justify-content:flex-end; margin-top:1rem;">
                    <button class="btn" @onclick="CancelImportModePrompt">Cancel</button>
                </div>
            </div>
        </div>
    }

    @* === Folder name prompt modal === *@
    @if (ShowFolderNamePrompt)
    {
        <div class="modal-overlay" @onclick="CancelFolderPrompt">
            <div class="dialog-panel" @onclick:stopPropagation="true" @onclick="@(() => { })">
                <h3>📂 Link Folder</h3>
                <input type="text" class="form-control" @bind="FolderDisplayName" @onkeydown="OnFolderNameKey"
                    placeholder="Display name" autofocus />
                <label style="display:flex; align-items:center; gap:0.5rem; margin-top:0.75rem; font-size:0.85rem; color:var(--text-muted); cursor:pointer;">
                    <input type="checkbox" @bind="FolderReadOnly" />
                    Mount as read-only
                </label>
                <div style="display:flex; gap:0.5rem; justify-content:flex-end; margin-top:1rem;">
                    <button class="btn" @onclick="CancelFolderPrompt">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmFolderLink">Link</button>
                </div>
            </div>
        </div>
    }

    @* === New Folder prompt modal === *@
    @if (ShowNewFolderPrompt_)
    {
        <div class="modal-overlay" @onclick="CancelNewFolderPrompt">
            <div class="dialog-panel" @onclick:stopPropagation="true" @onclick="@(() => { })">
                <h3>📁 New Folder</h3>
                <input type="text" class="form-control" @bind="NewFolderName" @onkeydown="OnNewFolderKey"
                    placeholder="Folder name" autofocus />
                <div style="display:flex; gap:0.5rem; justify-content:flex-end; margin-top:1rem;">
                    <button class="btn" @onclick="CancelNewFolderPrompt">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmNewFolder"
                        disabled="@string.IsNullOrWhiteSpace(NewFolderName)">Create</button>
                </div>
            </div>
        </div>
    }

    @* === Rename modal === *@
    @if (ShowRenamePrompt_)
    {
        <div class="modal-overlay" @onclick="CancelRename">
            <div class="dialog-panel" @onclick:stopPropagation="true" @onclick="@(() => { })">
                <h3>✏ Rename</h3>
                <input type="text" class="form-control" @bind="RenameName" @onkeydown="OnRenameKey"
                    placeholder="New name" autofocus />
                <div style="display:flex; gap:0.5rem; justify-content:flex-end; margin-top:1rem;">
                    <button class="btn" @onclick="CancelRename">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmRename"
                        disabled="@string.IsNullOrWhiteSpace(RenameName)">Rename</button>
                </div>
            </div>
        </div>
    }

    @* === New Playlist modal === *@
    @if (ShowPlaylistPrompt_)
    {
        <div class="modal-overlay" @onclick="CancelPlaylistPrompt">
            <div class="dialog-panel" @onclick:stopPropagation="true" @onclick="@(() => { })">
                <h3>🎵 New Playlist</h3>
                <input type="text" class="form-control" @bind="PlaylistName" @onkeydown="OnPlaylistKey"
                    placeholder="Playlist name" autofocus />
                <div style="display:flex; gap:0.5rem; justify-content:flex-end; margin-top:1rem;">
                    <button class="btn" @onclick="CancelPlaylistPrompt">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmNewPlaylist"
                        disabled="@string.IsNullOrWhiteSpace(PlaylistName)">Create</button>
                </div>
            </div>
        </div>
    }

    @* === Add to Playlist picker modal === *@
    @if (_showPlaylistPicker)
    {
        <div class="modal-overlay" @onclick="CancelPlaylistPicker">
            <div class="dialog-panel" @onclick:stopPropagation="true" @onclick="@(() => { })">
                <h3>🎵 Add to Playlist</h3>
                @if (_availablePlaylists.Count == 0)
                {
                    <p style="color:var(--text-muted); font-size:0.85rem;">No playlists found in this directory. Create one first.</p>
                }
                else
                {
                    <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:0.5rem;">Select a playlist:</p>
                    <div style="display:flex; flex-direction:column; gap:0.25rem; max-height:200px; overflow-y:auto;">
                        @foreach (var pl in _availablePlaylists)
                        {
                            <button class="btn" style="text-align:left; width:100%; box-sizing:border-box;"
                                    @onclick="@(() => _ = AddFileToPlaylist(pl))">
                                🎵 @pl.Name
                            </button>
                        }
                    </div>
                }
                <div style="display:flex; justify-content:flex-end; margin-top:1rem;">
                    <button class="btn" @onclick="CancelPlaylistPicker">Cancel</button>
                </div>
            </div>
        </div>
    }

    @* === Add Torrent modal === *@
    @if (ShowTorrentPrompt)
    {
        <div class="modal-overlay" @onclick="CancelTorrentPrompt">
            <div class="dialog-panel" @onclick:stopPropagation="true" @onclick="@(() => { })">
                <h3>🧲 Add Torrent</h3>
                <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:1rem;">
                    Paste a magnet link / info hash, or open a .torrent file.
                </p>
                <input type="text" class="form-control" @bind="TorrentSource"
                    placeholder="magnet:?xt=urn:btih:... or info hash" autofocus
                    style="margin-bottom:0.75rem;" />
                <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem;">
                    <span style="color:var(--text-muted); font-size:0.85rem;">— or —</span>
                    <label class="btn" style="margin:0; cursor:pointer;">
                        📂 Open .torrent
                        <InputFile accept=".torrent" OnChange="OnTorrentFileSelected"
                            style="display:none;" />
                    </label>
                    @if (TorrentFile != null)
                    {
                        <span style="font-size:0.85rem; color:var(--text-muted);">@TorrentFile.Name</span>
                    }
                </div>
                <input type="text" class="form-control" @bind="TorrentDisplayName"
                    @onkeydown="OnTorrentKey"
                    placeholder="Display name (optional)" />
                <div style="display:flex; gap:0.5rem; justify-content:flex-end; margin-top:1rem;">
                    <button class="btn" @onclick="CancelTorrentPrompt">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmAddTorrent"
                        disabled="@(HasNoTorrentInput || IsAddingTorrent)">
                        @(IsAddingTorrent ? "Adding…" : "Add")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // === State ===
    private static string CurrentPath = "/";
    private static double _savedScrollTop;
    private bool _shouldRestoreScroll;
    private List<IVfsNode> CurrentNodes = new();
    private bool IsLoading = true;
    private bool IsDragOver;
    private string? StatusMessage;
    // Context menu
    private bool _contextMenuVisible;
    private double _contextMenuX;
    private double _contextMenuY;
    private IVfsNode? _contextMenuNode;
    private System.Threading.Timer? _longPressTimer;
    private IVfsNode? _longPressNode;

    // New Playlist modal
    private bool ShowPlaylistPrompt_;
    private string PlaylistName = "";

    // Import mode prompt
    private bool ShowImportModePrompt;

    // Folder linking modal
    private bool ShowFolderNamePrompt;
    private string FolderDisplayName = "";
    private bool FolderReadOnly;
    private FileSystemDirectoryHandle? _pendingHandle;

    // New Folder modal
    private bool ShowNewFolderPrompt_;
    private string NewFolderName = "";

    // Rename modal
    private bool ShowRenamePrompt_;
    private string RenameName = "";
    private IVfsNode? _renameNode;

    // Add Torrent modal
    private bool ShowTorrentPrompt;
    private string TorrentSource = "";
    private string TorrentDisplayName = "";
    private bool IsAddingTorrent;
    private IBrowserFile? TorrentFile;
    private bool HasNoTorrentInput => string.IsNullOrWhiteSpace(TorrentSource) && TorrentFile == null;

    // Object URL cache removed — all files served via /vfs/ proxy

    // Playlist picker
    private bool _showPlaylistPicker;
    private IVfsFile? _playlistPickerFile;
    private List<IVfsFile> _availablePlaylists = new();

    protected override async Task OnInitializedAsync()
    {
        MediaLibrary.OnChanged += Refresh;
        MediaLibrary.VFS.OnMountsChanged += Refresh;
        MediaLibrary.VFS.OnContentChanged += OnVfsContentChanged;
        _shouldRestoreScroll = true;
        await LoadCurrentPath();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_shouldRestoreScroll)
        {
            _shouldRestoreScroll = false;
            try
            {
                JS.CallVoid("eval",
                    $"document.querySelector('.library-page')?.scrollTo(0, {_savedScrollTop})");
            }
            catch { /* component may have been disposed */ }
        }
    }

    private async void Refresh()
    {
        await LoadCurrentPath();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Refresh when VFS content changes affect the currently viewed path.</summary>
    private void OnVfsContentChanged(VfsChangeEventArgs args)
    {
        // Refresh if: the changed path is under us, OR we are inside the changed subtree
        if (args.Path.StartsWith(CurrentPath, StringComparison.OrdinalIgnoreCase)
            || CurrentPath.StartsWith(args.Path, StringComparison.OrdinalIgnoreCase))
        {
            Refresh();
        }
    }

    private async Task LoadCurrentPath()
    {
        IsLoading = true;
        try
        {
            var nodes = await MediaLibrary.VFS.ListDirectoryAsync(CurrentPath);

            CurrentNodes = nodes
                .Where(n => n is not IVfsFile f || !f.Name.EndsWith(".mount", StringComparison.OrdinalIgnoreCase))
                .OrderBy(n => n.NodeType == VfsNodeType.File ? 1 : 0) // directories first
                .ThenBy(n => n.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();

            // Auto-select image files in torrent folders so thumbnails load on-demand
            AutoSelectTorrentImages();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"VFS ListDirectory error: {ex.Message}");
            CurrentNodes = new();
        }
        IsLoading = false;
    }

    /// <summary>When browsing inside a torrent folder, select image files so thumbnails fetch on demand.</summary>
    private void AutoSelectTorrentImages()
    {
        foreach (var node in CurrentNodes)
        {
            if (node is IVfsFile file && node.Handler is WebTorrentFsHandler wtHandler)
            {
                if (file.MimeType?.StartsWith("image/") == true)
                {
                    var relPath = GetTorrentRelativePath(file.Path, wtHandler);
                    if (!wtHandler.IsFileSelected(relPath))
                    {
                        wtHandler.SelectFile(relPath);
                    }
                }
            }
        }
    }

    /// <summary>Get the relative path of a VFS path within a torrent handler's mount.</summary>
    private static string GetTorrentRelativePath(string vfsPath, WebTorrentFsHandler handler)
    {
        var mountPath = handler.GetMountPath();
        if (vfsPath.StartsWith(mountPath, StringComparison.OrdinalIgnoreCase))
        {
            return vfsPath.Substring(mountPath.Length).TrimStart('/');
        }
        return vfsPath.TrimStart('/');
    }

    /// <summary>Render torrent file status: progress bar + state badge.</summary>
    private string GetTorrentFileStatusHtml(WebTorrentFsHandler handler, IVfsFile file)
    {
        var relPath = GetTorrentRelativePath(file.Path, handler);
        var progress = handler.GetFileProgress(relPath);
        var isSelected = handler.IsFileSelected(relPath);

        var sb = new System.Text.StringBuilder();

        // Progress bar — always shown for torrent files
        var pct = progress * 100;
        var barColor = progress >= 1.0 ? "var(--accent-green, #4caf50)" : isSelected ? "var(--accent, #ff6d00)" : "var(--text-muted, #888)";
        sb.Append($"<div class=\"progress-bar-container\"><div class=\"progress-bar-fill\" style=\"width:{pct:F1}%;background:{barColor}\"></div></div>");

        // Status line: badge + percentage
        if (progress >= 1.0)
        {
            sb.Append("<div class=\"torrent-status-line\"><span class=\"badge badge-complete\">✅ Complete</span></div>");
        }
        else if (isSelected)
        {
            sb.Append($"<div class=\"torrent-status-line\"><span class=\"badge badge-downloading\">⬇️ {pct:F0}%</span></div>");
        }
        else
        {
            sb.Append($"<div class=\"torrent-status-line\"><span class=\"badge badge-paused\">⏸ Paused</span>");
            if (progress > 0)
                sb.Append($" <span class=\"progress-label\">{pct:F0}%</span>");
            sb.Append("</div>");
        }

        return sb.ToString();
    }

    /// <summary>Render torrent folder status: overall progress, peer count, speed.</summary>
    private string GetTorrentFolderStatusHtml(WebTorrentFsHandler handler, IVfsNode node)
    {
        var torrent = handler.Torrent;

        // Not yet initialized at all
        if (torrent == null)
            return "<div class=\"torrent-status-line\"><span class=\"badge badge-stalled\">⏳ Initializing…</span></div>";

        // Torrent exists but metadata not yet received (still connecting to trackers/peers)
        if (!handler.IsReady)
            return "<div class=\"torrent-status-line\"><span class=\"badge badge-stalled\">🔗 Connecting…</span></div>";

        var sb = new System.Text.StringBuilder();

        // Progress bar
        var progress = torrent.Progress;
        var pct = progress * 100;
        var barColor = progress >= 1.0 ? "var(--accent-green, #4caf50)" : "var(--accent, #ff6d00)";
        sb.Append($"<div class=\"progress-bar-container\"><div class=\"progress-bar-fill\" style=\"width:{pct:F1}%;background:{barColor}\"></div></div>");

        // Status line: state badge + peers + speed
        sb.Append("<div class=\"torrent-status-line\">");
        if (progress >= 1.0)
        {
            sb.Append("<span class=\"badge badge-complete\">✅ Complete</span>");
        }
        else if (torrent.Paused)
        {
            sb.Append($"<span class=\"badge badge-paused\">⏸ Paused</span> <span class=\"progress-label\">{pct:F0}%</span>");
        }
        else
        {
            var speed = torrent.DownloadSpeed;
            if (speed > 0)
                sb.Append($"<span class=\"badge badge-downloading\">⬇️ {pct:F0}%</span> <span class=\"torrent-speed\">{FormatSpeed(speed)}</span>");
            else
                sb.Append($"<span class=\"badge badge-stalled\">⏳ {pct:F0}%</span>");
        }

        // Peer count
        var peers = torrent.NumPeers;
        if (peers > 0)
            sb.Append($" <span class=\"torrent-peers\">{peers} peer{(peers != 1 ? "s" : "")}</span>");
        else
            sb.Append(" <span class=\"torrent-peers torrent-peers-zero\">0 peers</span>");

        sb.Append("</div>");
        return sb.ToString();
    }

    private static string FormatSpeed(double bytesPerSec)
    {
        if (bytesPerSec >= 1048576) return $"{bytesPerSec / 1048576:F1} MB/s";
        if (bytesPerSec >= 1024) return $"{bytesPerSec / 1024:F0} KB/s";
        return $"{bytesPerSec:F0} B/s";
    }


    private async Task NavigateTo(string path)
