    private async Task AddFileToPlaylist(IVfsFile playlist)
    {
        if (_playlistPickerFile == null) return;
        var filePath = _playlistPickerFile.Path;
        _showPlaylistPicker = false;
        _playlistPickerFile = null;

        try
        {
            // Read existing content
            var existing = await MediaLibrary.VFS.ReadTextAsync(playlist.Path) ?? "";

            // Compute relative path from playlist dir to file
            var playlistDir = playlist.Path.Contains('/')
                ? playlist.Path[..playlist.Path.LastIndexOf('/')]
                : "/";
            string entry;
            if (filePath.StartsWith(playlistDir + "/", StringComparison.OrdinalIgnoreCase))
            {
                entry = filePath[(playlistDir.Length + 1)..];
            }
            else
            {
                entry = filePath; // absolute VFS path fallback
            }

            // Append entry
            var newContent = existing.TrimEnd() + "\n" + entry + "\n";
            await MediaLibrary.VFS.WriteTextAsync(playlist.Path, newContent);

            StatusMessage = $"Added to \"{playlist.Name}\"";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"AddFileToPlaylist error: {ex.Message}");
            StatusMessage = "Error adding to playlist.";
        }
        StateHasChanged();
        await Task.Delay(2000);
        StatusMessage = null;
    }

    public void Dispose()
    {
        SaveScrollPosition();
        _longPressTimer?.Dispose();
        MediaLibrary.OnChanged -= Refresh;
        MediaLibrary.VFS.OnMountsChanged -= Refresh;
        MediaLibrary.VFS.OnContentChanged -= OnVfsContentChanged;
    }
}
