    private List<(string label, string path)> GetBreadcrumbs()
    {
        var crumbs = new List<(string, string)> { ("🏠 Root", "/") };
        if (CurrentPath == "/") return crumbs;

        var segments = CurrentPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var cumulative = "";
        foreach (var seg in segments)
        {
            cumulative += $"/{seg}";
            crumbs.Add((seg, cumulative));
        }
        return crumbs;
    }

