    // === Delete ===

    private async Task DeleteNode(IVfsNode node)
    {
        try
        {
            // If this is a mount point, use proper service cleanup
            if (node.Handler is FileSystemAccessFsHandler)
            {
                await UnlinkFolder(node);
                return;
            }
            else if (node.Handler is WebTorrentFsHandler wtHandler)
            {
                var name = node.Name;
                try
                {
                    await WtManager.RemoveTorrentAsync(wtHandler.TorrentSource ?? wtHandler.DisplayName);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"RemoveTorrentAsync warning: {ex.Message}");
                    // The torrent may still have been removed successfully — continue
                }
                StatusMessage = $"Removed torrent \"{name}\"";
                await LoadCurrentPath();
                StateHasChanged();
                await Task.Delay(2000);
                StatusMessage = null;
                return;
            }
            else
            {
                // Regular VFS delete (e.g. OPFS file/folder)
                await MediaLibrary.VFS.DeleteAsync(node.Path, recursive: true);
                StatusMessage = $"Deleted \"{node.Name}\"";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"DeleteNode error: {ex.Message}");
            StatusMessage = "Error deleting item.";
        }
        await LoadCurrentPath();
        StateHasChanged();
        await Task.Delay(2000);
        StatusMessage = null;
    }

    // === Helpers ===

    private bool IsUnlinkable(IVfsNode node)
    {
        return node.Handler is FileSystemAccessFsHandler;
    }

    private bool IsDeletable(IVfsNode node)
    {
        // A node is deletable if the directory containing it is writable.
        // This means mounts are deletable (their .mount file is in OPFS)
        // even if the mount contents are read-only.
        var parentPath = node.Path.Contains('/')
            ? node.Path[..node.Path.LastIndexOf('/')]
            : "/";
        if (string.IsNullOrEmpty(parentPath)) parentPath = "/";
        return MediaLibrary.VFS.IsWritable(parentPath);
    }

    private bool IsRenamable(IVfsNode node)
    {
        // Only items inside a writable handler can be renamed
        return node.Handler is IWritableFsHandler;
    }

