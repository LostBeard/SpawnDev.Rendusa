    private async Task LoadAndPlayPlaylist(IVfsFile file)
    {
        try
        {
            var content = await MediaLibrary.VFS.ReadTextAsync(file.Path);
            if (content == null) return;

            var items = new List<IVfsFile>();
            var basePath = file.Path.Contains('/')
                ? file.Path[..file.Path.LastIndexOf('/')]
                : "/";

            foreach (var line in content.Split('\n', StringSplitOptions.RemoveEmptyEntries))
            {
                var trimmed = line.Trim();
                if (trimmed.StartsWith("#") || string.IsNullOrWhiteSpace(trimmed)) continue;

                // Resolve relative or absolute VFS paths
                var itemPath = trimmed.StartsWith("/")
                    ? trimmed
                    : (basePath == "/" ? $"/{trimmed}" : $"{basePath}/{trimmed}");

                var node = await MediaLibrary.VFS.ResolveAsync(itemPath);
                if (node is IVfsFile f)
                {
                    items.Add(f);
                }
            }

            if (items.Count > 0)
            {
                var mediaItems = items.Select(f => new MediaItem
                {
                    Title = f.Name,
                    SourceUri = "/vfs" + f.Path,
                    MimeType = f.MimeType,
                    Type = MediaLibraryService.DetectMediaType(f.MimeType)
                }).ToList();
                NowPlaying.SetItems(mediaItems, mediaItems[0].Id);
                Navigation.NavigateTo("/player?fromFolder=true");
                StatusMessage = $"Playing playlist \"{file.Name}\" ({items.Count} items)";
                StateHasChanged();
                await Task.Delay(2000);
                StatusMessage = null;
            }
            else
            {
                StatusMessage = "Playlist is empty.";
                StateHasChanged();
                await Task.Delay(2000);
                StatusMessage = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadAndPlayPlaylist error: {ex.Message}");
            StatusMessage = "Error loading playlist.";
            StateHasChanged();
            await Task.Delay(2000);
            StatusMessage = null;
        }
    }

